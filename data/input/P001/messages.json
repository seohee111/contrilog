    "channel": "#dev",
    "channel_type": "CHANNEL",
    "sender_id": "M_A",
    "recipient_ids": [],
    "sent_at": "2026-09-30T19:10:00+09:00",
    "text": "타임라인 뷰 실제 API 연동했어요.",
    "reply_to_message_id": null
  },
  {
