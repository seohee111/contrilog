    "message_id": "MSG-025",
    "project_id": "P001",
    "channel": "#dev",
    "channel_type": "CHANNEL",
    "sender_id": "M_D",
    "recipient_ids": [],
    "sent_at": "2026-09-30T10:50:00+09:00",
    "text": "preprocess.py 수정했어요. window를 기준일 이전으로만 자르고 split도 시간순으로 바꿨어요.",
    "reply_to_message_id": "MSG-018"
  },
