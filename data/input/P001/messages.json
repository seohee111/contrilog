    "message_id": "MSG-026",
    "project_id": "P001",
    "channel": "#dev",
    "channel_type": "CHANNEL",
    "sender_id": "M_A",
    "recipient_ids": [],
    "sent_at": "2026-09-30T15:10:00+09:00",
