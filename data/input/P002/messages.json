    "project_id": "P002",
    "channel": "#shiptrack-dev",
    "channel_type": "CHANNEL",
    "sender_id": "M_C",
    "recipient_ids": [],
    "sent_at": "2026-06-02T11:15:00+09:00",
    "text": "다인님 덕분에 운영에서도 지도 잘 나와요. 감사합니다!",
    "reply_to_message_id": "MSG-028"
  },
  {
