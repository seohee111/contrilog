    "project_id": "P002",
    "channel": "#shiptrack-dev",
    "channel_type": "CHANNEL",
    "sender_id": "M_B",
    "recipient_ids": [],
    "sent_at": "2026-05-07T15:45:00+09:00",
    "text": "됐어요! 감사합니다.",
